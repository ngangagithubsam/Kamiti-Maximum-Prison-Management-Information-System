// ============================================================
// DELETE
// ============================================================
function confirmDelete(store, id, name) {
  document.getElementById('confirm-msg').textContent = `Delete "${name}"? This action cannot be undone.`;
  document.getElementById('confirm-ok-btn').onclick = async () => {
    try {
      await dbDelete(store, id);
      closeModal('confirm'); showNotif('Record deleted', 'info');
      const refreshMap = { prisoners: renderPrisoners, visitations: renderVisitations, incidents: renderIncidents, movements: renderMovements, cells: renderCells, shifts: renderShifts, shift_swaps: renderSwaps, court: renderCourt, reports: renderReports, medical: renderMedical, staff: renderStaff, audit: renderAudit, rehab_programs: renderRehabPrograms, rehab_enrollments: renderEnrollments, inventory_items: renderInventoryItems, inventory_transactions: renderTransactions };
      if (refreshMap[store]) refreshMap[store]();
      updateNavCounts();
    } catch(e) { showNotif(e.message, 'error'); }
  };
  document.getElementById('modal-confirm').classList.add('open');
}

// ============================================================
// RENDER HELPERS
// ============================================================
function severityBadge(s) { const m={Low:'badge-green',Medium:'badge-amber',High:'badge-red',Critical:'badge-red'}; return `<span class="badge ${m[s]||'badge-gray'}">${s||'â€”'}</span>`; }
function statusBadge(s) { const m={Active:'badge-green',Released:'badge-blue',Transferred:'badge-amber',Deceased:'badge-gray',Scheduled:'badge-blue',Completed:'badge-green',Denied:'badge-red',Cancelled:'badge-gray',Open:'badge-amber','Under Review':'badge-blue',Resolved:'badge-green',Closed:'badge-gray',Ongoing:'badge-amber',Referred:'badge-purple',Critical:'badge-red',Available:'badge-green',Maintenance:'badge-amber',Full:'badge-red','Low Stock':'badge-amber','Out of Stock':'badge-red',Upcoming:'badge-blue',Suspended:'badge-amber',Absent:'badge-red',Swapped:'badge-purple',Approved:'badge-green',Pending:'badge-amber',Rejected:'badge-red',Dropped:'badge-red'}; return `<span class="badge ${m[s]||'badge-gray'}">${s||'â€”'}</span>`; }
function fmtDate(d) { if(!d) return 'â€”'; try { return new Date(d).toLocaleDateString('en-KE',{day:'2-digit',month:'short',year:'numeric'}); } catch{return d;} }
function fmtDateTime(d) { if(!d) return 'â€”'; try { return new Date(d).toLocaleString('en-KE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); } catch{return d;} }

// ============================================================
// RENDER FUNCTIONS
// ============================================================
async function renderDashboard() {
  const stats = await getStats();
  document.getElementById('stat-total').textContent    = stats.total_prisoners || 0;
  document.getElementById('stat-housed').textContent   = stats.active_prisoners || 0;
  document.getElementById('stat-incidents').textContent= stats.incidents_30d || 0;
  document.getElementById('stat-visits').textContent   = stats.visits_today || 0;
  if(document.getElementById('stat-shifts')) document.getElementById('stat-shifts').textContent = stats.shifts_today || 0;
  if(document.getElementById('stat-lowstock')) document.getElementById('stat-lowstock').textContent = stats.low_stock_items || 0;
  if(document.getElementById('stat-rehab')) document.getElementById('stat-rehab').textContent = stats.active_rehab || 0;

  const [prisoners, incidents, audit] = await Promise.all([dbGetAll('prisoners'), dbGetAll('incidents'), dbGetAll('audit_log')]);

  const admTbody = document.getElementById('dash-admissions-body');
  const recent = [...prisoners].sort((a,b)=>new Date(b.admdate)-new Date(a.admdate)).slice(0,5);
  admTbody.innerHTML = recent.map(p=>`<tr><td class="text-mono text-accent">${p.prisonerId}</td><td style="color:var(--text)">${p.firstname} ${p.lastname}</td><td>${p.cell||'â€”'}</td><td>${fmtDate(p.admdate)}</td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--text3)">No data</td></tr>';

  const incTbody = document.getElementById('dash-incidents-body');
  const recentInc = [...incidents].sort((a,b)=>new Date(b.incidentDate||b.created_at)-new Date(a.incidentDate||a.created_at)).slice(0,5);
  incTbody.innerHTML = recentInc.map(i=>`<tr><td>${i.type}</td><td style="color:var(--text)">${i.prisonerName}</td><td>${severityBadge(i.severity)}</td><td>${fmtDate(i.incidentDate)}</td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--text3)">No incidents</td></tr>';

  const actDiv = document.getElementById('dash-activity');
  const recent10 = [...audit].sort((a,b)=>new Date(b.ts)-new Date(a.ts)).slice(0,10);
  actDiv.innerHTML = recent10.map(a=>`<div class="log-item"><div class="log-icon" style="background:var(--bg4)"><svg viewBox="0 0 24 24" fill="var(--accent)" width="16" height="16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div><div class="log-text"><div class="log-title">${a.action} â€” ${a.module}</div><div class="log-meta">${a.user} Â· ${a.details||''}</div></div><div class="log-time">${fmtDateTime(a.ts)}</div></div>`).join('') || '<div style="color:var(--text3);font-size:13px;padding:8px">No activity yet</div>';

  updateNavCounts();
}

async function updateNavCounts() {
  const [prisoners, enrollments, items] = await Promise.all([dbGetAll('prisoners'), dbGetAll('rehab_enrollments'), dbGetAll('inventory')]);
  document.getElementById('nav-prisoner-count').textContent = prisoners.filter(p=>p.status==='Active').length;
  const rehabEl = document.getElementById('nav-rehab-count');
  if(rehabEl) rehabEl.textContent = enrollments.filter(e=>e.status==='Active').length;
  const stockEl = document.getElementById('nav-stock-alert');
  const lowStock = items.filter(i=>i.status==='Low Stock'||i.status==='Out of Stock').length;
  if(stockEl){ stockEl.style.display = lowStock>0?'':'none'; }
}

async function renderPrisoners() {
  const prisoners = await dbGetAll('prisoners');
  const q = (document.getElementById('prisoner-search')?.value||'').toLowerCase();
  const sf = document.getElementById('prisoner-filter')?.value||'';
  const tbody = document.getElementById('prisoners-tbody');
  let filtered = getFilteredData(prisoners, 'prisoner');
  filtered = filtered.filter(p => (!sf||p.status===sf) && (!q||`${p.firstname} ${p.lastname} ${p.prisonerId}`.toLowerCase().includes(q)));
  tbody.innerHTML = filtered.map(p=>`<tr><td class="text-mono text-accent">${p.prisonerId}</td><td style="color:var(--text)">${p.firstname} ${p.lastname}</td><td>${fmtDate(p.dob)}</td><td>${p.cell||'â€”'}</td><td>${p.sentence||0} mo.</td><td>${statusBadge(p.status)}</td><td><button class="btn btn-secondary btn-sm" onclick="openModal('prisoner',${p.id})">Edit</button> <button class="btn btn-danger btn-sm" onclick="confirmDelete('prisoners',${p.id},'${p.firstname} ${p.lastname}')">Del</button></td></tr>`).join('') || `<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:40px">No prisoners found</td></tr>`;
}

async function renderVisitations() {
  const visits = await dbGetAll('visitations');
  const q = (document.getElementById('visit-search')?.value||'').toLowerCase();
  const tbody = document.getElementById('visit-tbody');
  let filtered = getFilteredData(visits, 'visit');
  filtered = filtered.filter(v => !q || `${v.prisonerName} ${v.visitorname} ${v.visitId}`.toLowerCase().includes(q));
  tbody.innerHTML = filtered.map(v=>`<tr><td class="text-mono text-accent">${v.visitId}</td><td style="color:var(--text)">${v.prisonerName}</td><td>${v.visitorname}</td><td>${v.relationship||'â€”'}</td><td>${fmtDateTime(v.visitDate)}</td><td>${statusBadge(v.status)}</td><td><button class="btn btn-secondary btn-sm" onclick="openModal('visit',${v.id})">Edit</button> <button class="btn btn-danger btn-sm" onclick="confirmDelete('visitations',${v.id},'${v.visitId}')">Del</button></td></tr>`).join('') || `<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:40px">No visits found</td></tr>`;
}

async function renderIncidents() {
