async function renderReports() {
  const reports = await dbGetAll('reports');
  const div = document.getElementById('reports-list');
  if (!reports.length) { div.innerHTML = '<div class="empty-state"><p>No reports yet.</p></div>'; return; }
  div.innerHTML = [...reports].sort((a,b)=>new Date(b.reportDate||b.created_at)-new Date(a.reportDate||a.created_at)).map(r=>`<div class="report-card"><div style="display:flex;align-items:flex-start;justify-content:space-between"><div><div class="report-title">${r.title}</div><div class="report-meta">${r.reportId} &nbsp;|&nbsp; ${r.type} &nbsp;|&nbsp; ${r.author} &nbsp;|&nbsp; ${fmtDateTime(r.reportDate||r.created_at)}</div></div><button class="btn btn-danger btn-sm" onclick="confirmDelete('reports',${r.id},'${r.title}')">Delete</button></div><div class="report-body">${r.body}</div></div>`).join('');
}

